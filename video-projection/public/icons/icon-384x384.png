<svg width="384" height="384" viewBox="0 0 384 384" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="arcReactor" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#60a5fa;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#3b82f6;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#1e40af;stop-opacity:0.6" />
    </radialGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge> 
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Outer ring -->
  <circle cx="384_HALF" cy="384_HALF" r="384_QUARTER" fill="none" stroke="#3b82f6" stroke-width="2" filter="url(#glow)"/>
  
  <!-- Inner core -->
  <circle cx="384_HALF" cy="384_HALF" r="384_EIGHTH" fill="url(#arcReactor)" filter="url(#glow)"/>
  
  <!-- Play triangle -->
  <polygon points="384_PLAY_X1,384_PLAY_Y1 384_PLAY_X2,384_PLAY_Y2 384_PLAY_X3,384_PLAY_Y3" fill="#ffffff" opacity="0.9"/>
  
  <!-- Arc reactor lines -->
  <g stroke="#60a5fa" stroke-width="1" opacity="0.7">
    <line x1="384_HALF" y1="384_QUARTER_OFFSET" x2="384_HALF" y2="384_THREE_QUARTER_OFFSET"/>
    <line x1="384_QUARTER_OFFSET" y1="384_HALF" x2="384_THREE_QUARTER_OFFSET" y2="384_HALF"/>
  </g>
</svg>